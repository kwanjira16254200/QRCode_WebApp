{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/r/([^/]+)",
      "dest": "/api/r/[shortCode]?shortCode=$1"
    },
    {
      "src": "/s/([^/]+)",
      "dest": "/api/s/[shortCode]?shortCode=$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index"
    }
  ],
  "env": {
    "SUPABASE_URL": "@supabase_url",
    "SUPABASE_ANON_KEY": "@supabase_anon_key"
  }
}
