{
  "buildCommand": "cd client && npm ci && npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci && cd client && npm ci",
  "functions": {
    "api/r/[shortCode].js": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/r/:shortCode",
      "destination": "/api/r/[shortCode]"
    },
    {
      "source": "/gallery/:id",
      "destination": "/gallery/:id"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}