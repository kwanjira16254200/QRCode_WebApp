{
  "version": 2,
  "buildCommand": "cd client && npm install && npm run build",
  "outputDirectory": "client/dist",
  "installCommand": "npm install && cd client && npm install",
  "rewrites": [
    {
      "source": "/r/:shortCode",
      "destination": "/api/r/[shortCode]"
    },
    {
      "source": "/s/:shortCode",
      "destination": "/api/s/[shortCode]"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    }
  ]
}