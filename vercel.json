{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/r/([^/]+)",
      "dest": "/api/r/[shortCode]?shortCode=$1"
    },
    {
      "src": "/s/([^/]+)",
      "dest": "/api/s/[shortCode]?shortCode=$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}