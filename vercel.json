{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "client/dist"
      }
    },
    {
      "src": "api/r/[shortCode].js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/r/([^/]+)",
      "dest": "/api/r/[shortCode]?shortCode=$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}